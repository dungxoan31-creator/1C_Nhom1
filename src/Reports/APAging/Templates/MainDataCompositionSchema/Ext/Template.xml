<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>DataSource1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>DataSet1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Counterparty</dataPath>
			<field>Counterparty</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Contract</dataPath>
			<field>Contract</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Invoice</dataPath>
			<field>Invoice</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>DueDate</dataPath>
			<field>DueDate</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>TotalOutstanding</dataPath>
			<field>TotalOutstanding</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>CurrentNotDue</dataPath>
			<field>CurrentNotDue</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Overdue1_30</dataPath>
			<field>Overdue1_30</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Overdue31_60</dataPath>
			<field>Overdue31_60</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Overdue61_90</dataPath>
			<field>Overdue61_90</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>OverdueOver90</dataPath>
			<field>OverdueOver90</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	AP.Counterparty AS Counterparty,
	AP.Contract AS Contract,
	AP.Invoice AS Invoice,
	AP.Invoice.DueDate AS DueDate,
	AP.AmountBalance AS TotalOutstanding,
	CASE
		WHEN DATEDIFF(AP.Invoice.DueDate, &amp;Period, DAY) &lt;= 0
			THEN AP.AmountBalance
		ELSE 0
	END AS CurrentNotDue,
	CASE
		WHEN DATEDIFF(AP.Invoice.DueDate, &amp;Period, DAY) &gt;= 1
				AND DATEDIFF(AP.Invoice.DueDate, &amp;Period, DAY) &lt;= 30
			THEN AP.AmountBalance
		ELSE 0
	END AS Overdue1_30,
	CASE
		WHEN DATEDIFF(AP.Invoice.DueDate, &amp;Period, DAY) &gt;= 31
				AND DATEDIFF(AP.Invoice.DueDate, &amp;Period, DAY) &lt;= 60
			THEN AP.AmountBalance
		ELSE 0
	END AS Overdue31_60,
	CASE
		WHEN DATEDIFF(AP.Invoice.DueDate, &amp;Period, DAY) &gt;= 61
				AND DATEDIFF(AP.Invoice.DueDate, &amp;Period, DAY) &lt;= 90
			THEN AP.AmountBalance
		ELSE 0
	END AS Overdue61_90,
	CASE
		WHEN DATEDIFF(AP.Invoice.DueDate, &amp;Period, DAY) &gt; 90
			THEN AP.AmountBalance
		ELSE 0
	END AS OverdueOver90
FROM
	AccumulationRegister.AccountsPayable.Balance AS AP</query>
	</dataSet>
	<totalField>
		<dataPath>TotalOutstanding</dataPath>
		<expression>Sum(TotalOutstanding)</expression>
	</totalField>
	<totalField>
		<dataPath>CurrentNotDue</dataPath>
		<expression>Sum(CurrentNotDue)</expression>
	</totalField>
	<totalField>
		<dataPath>Overdue1_30</dataPath>
		<expression>Sum(Overdue1_30)</expression>
	</totalField>
	<totalField>
		<dataPath>Overdue31_60</dataPath>
		<expression>Sum(Overdue31_60)</expression>
	</totalField>
	<totalField>
		<dataPath>Overdue61_90</dataPath>
		<expression>Sum(Overdue61_90)</expression>
	</totalField>
	<totalField>
		<dataPath>OverdueOver90</dataPath>
		<expression>Sum(OverdueOver90)</expression>
	</totalField>
	<settingsVariant>
		<dcsset:name>Default</dcsset:name>
		<dcsset:presentation xsi:type="xs:string">Default</dcsset:presentation>
		<dcsset:settings xmlns:style="http://v8.1c.ru/8.1/data/ui/style" xmlns:sys="http://v8.1c.ru/8.1/data/ui/fonts/system" xmlns:web="http://v8.1c.ru/8.1/data/ui/colors/web" xmlns:win="http://v8.1c.ru/8.1/data/ui/colors/windows">
			<dcsset:selection>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Counterparty</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Contract</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Invoice</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>DueDate</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>TotalOutstanding</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>CurrentNotDue</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Overdue1_30</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Overdue31_60</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Overdue61_90</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>OverdueOver90</dcsset:field>
				</dcsset:item>
			</dcsset:selection>
			<dcsset:item xsi:type="dcsset:StructureItemGroup">
				<dcsset:groupItems>
					<dcsset:item xsi:type="dcsset:GroupItemField">
						<dcsset:field>Counterparty</dcsset:field>
						<dcsset:groupType>Items</dcsset:groupType>
						<dcsset:periodAdditionType>None</dcsset:periodAdditionType>
						<dcsset:periodAdditionBegin xsi:type="xs:dateTime">0001-01-01T00:00:00</dcsset:periodAdditionBegin>
						<dcsset:periodAdditionEnd xsi:type="xs:dateTime">0001-01-01T00:00:00</dcsset:periodAdditionEnd>
					</dcsset:item>
				</dcsset:groupItems>
				<dcsset:order>
					<dcsset:item xsi:type="dcsset:OrderItemAuto"/>
				</dcsset:order>
				<dcsset:selection>
					<dcsset:item xsi:type="dcsset:SelectedItemAuto"/>
				</dcsset:selection>
				<dcsset:item xsi:type="dcsset:StructureItemGroup">
					<dcsset:order>
						<dcsset:item xsi:type="dcsset:OrderItemAuto"/>
					</dcsset:order>
					<dcsset:selection>
						<dcsset:item xsi:type="dcsset:SelectedItemAuto"/>
					</dcsset:selection>
				</dcsset:item>
			</dcsset:item>
		</dcsset:settings>
	</settingsVariant>
</DataCompositionSchema>