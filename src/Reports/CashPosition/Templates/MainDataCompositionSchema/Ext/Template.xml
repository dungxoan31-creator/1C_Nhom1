<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>DataSource1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>DataSet1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>CashAccount</dataPath>
			<field>CashAccount</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>CashFlowItem</dataPath>
			<field>CashFlowItem</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>OpeningBalance</dataPath>
			<field>OpeningBalance</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Inflows</dataPath>
			<field>Inflows</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Outflows</dataPath>
			<field>Outflows</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ClosingBalance</dataPath>
			<field>ClosingBalance</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	CashFlowBalanceAndTurnovers.CashAccount AS CashAccount,
	CashFlowBalanceAndTurnovers.CashFlowItem AS CashFlowItem,
	CashFlowBalanceAndTurnovers.AmountOpeningBalance AS OpeningBalance,
	CashFlowBalanceAndTurnovers.AmountReceipt AS Inflows,
	CashFlowBalanceAndTurnovers.AmountExpense AS Outflows,
	CashFlowBalanceAndTurnovers.AmountClosingBalance AS ClosingBalance
FROM
	AccumulationRegister.CashFlow.BalanceAndTurnovers(, , Auto, , ) AS CashFlowBalanceAndTurnovers</query>
	</dataSet>
	<totalField>
		<dataPath>OpeningBalance</dataPath>
		<expression>Sum(OpeningBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>Inflows</dataPath>
		<expression>Sum(Inflows)</expression>
	</totalField>
	<totalField>
		<dataPath>Outflows</dataPath>
		<expression>Sum(Outflows)</expression>
	</totalField>
	<totalField>
		<dataPath>ClosingBalance</dataPath>
		<expression>Sum(ClosingBalance)</expression>
	</totalField>
	<settingsVariant>
		<dcsset:name>Default</dcsset:name>
