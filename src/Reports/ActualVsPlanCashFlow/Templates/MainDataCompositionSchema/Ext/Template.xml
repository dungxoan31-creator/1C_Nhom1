<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>DataSource1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>DataSet1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>CashFlowItem</dataPath>
			<field>CashFlowItem</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>PlannedAmount</dataPath>
			<field>PlannedAmount</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ActualAmount</dataPath>
			<field>ActualAmount</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Variance</dataPath>
			<field>Variance</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	ISNULL(Plan.CashFlowItem, Actual.CashFlowItem) AS CashFlowItem,
	ISNULL(Plan.PlanAmount, 0) AS PlannedAmount,
	ISNULL(Actual.ActualAmount, 0) AS ActualAmount,
	ISNULL(Plan.PlanAmount, 0) - ISNULL(Actual.ActualAmount, 0) AS Variance
FROM
	(SELECT
		CFP.CashFlowItem AS CashFlowItem,
		SUM(CFP.PlannedAmountTurnover) AS PlanAmount
	FROM
		AccumulationRegister.CashFlowPlan.Turnovers AS CFP
	GROUP BY
		CFP.CashFlowItem) AS Plan
		FULL JOIN (SELECT
			CF.CashFlowItem AS CashFlowItem,
			SUM(CF.AmountExpense) AS ActualAmount
		FROM
			AccumulationRegister.CashFlow.Turnovers AS CF
		GROUP BY
			CF.CashFlowItem) AS Actual
		ON Plan.CashFlowItem = Actual.CashFlowItem</query>
	</dataSet>
	<totalField>
		<dataPath>PlannedAmount</dataPath>
		<expression>Sum(PlannedAmount)</expression>
	</totalField>
	<totalField>
		<dataPath>ActualAmount</dataPath>
		<expression>Sum(ActualAmount)</expression>
	</totalField>
	<totalField>
		<dataPath>Variance</dataPath>
		<expression>Sum(Variance)</expression>
	</totalField>
	<settingsVariant>
		<dcsset:name>Default</dcsset:name>
		<dcsset:presentation xsi:type="xs:string">Default</dcsset:presentation>
		<dcsset:settings xmlns:style="http://v8.1c.ru/8.1/data/ui/style" xmlns:sys="http://v8.1c.ru/8.1/data/ui/fonts/system" xmlns:web="http://v8.1c.ru/8.1/data/ui/colors/web" xmlns:win="http://v8.1c.ru/8.1/data/ui/colors/windows">
			<dcsset:selection>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>CashFlowItem</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>PlannedAmount</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>ActualAmount</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Variance</dcsset:field>
				</dcsset:item>
			</dcsset:selection>
			<dcsset:item xsi:type="dcsset:StructureItemGroup">
				<dcsset:groupItems>
					<dcsset:item xsi:type="dcsset:GroupItemField">
						<dcsset:field>CashFlowItem</dcsset:field>
						<dcsset:groupType>Items</dcsset:groupType>
						<dcsset:periodAdditionType>None</dcsset:periodAdditionType>
						<dcsset:periodAdditionBegin xsi:type="xs:dateTime">0001-01-01T00:00:00</dcsset:periodAdditionBegin>
						<dcsset:periodAdditionEnd xsi:type="xs:dateTime">0001-01-01T00:00:00</dcsset:periodAdditionEnd>
					</dcsset:item>
				</dcsset:groupItems>
				<dcsset:order>
					<dcsset:item xsi:type="dcsset:OrderItemAuto"/>
				</dcsset:order>
				<dcsset:selection>
					<dcsset:item xsi:type="dcsset:SelectedItemAuto"/>
				</dcsset:selection>
				<dcsset:item xsi:type="dcsset:StructureItemGroup">
					<dcsset:order>
						<dcsset:item xsi:type="dcsset:OrderItemAuto"/>
					</dcsset:order>
					<dcsset:selection>
						<dcsset:item xsi:type="dcsset:SelectedItemAuto"/>
					</dcsset:selection>
				</dcsset:item>
			</dcsset:item>
		</dcsset:settings>
	</settingsVariant>
</DataCompositionSchema>